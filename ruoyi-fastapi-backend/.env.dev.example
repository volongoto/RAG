APP_ENV='dev'
APP_NAME='Cradle-FastAPI'
APP_ROOT_PATH='/dev-api'
APP_HOST='0.0.0.0'
APP_PORT=29099
APP_VERSION='1.8.1'
APP_RELOAD=true
APP_IP_LOCATION_QUERY=true
APP_SAME_TIME_LOGIN=true

JWT_SECRET_KEY='replace-with-a-strong-secret'
JWT_ALGORITHM='HS256'
JWT_EXPIRE_MINUTES=1440
JWT_REDIS_EXPIRE_MINUTES=30

DB_TYPE='postgresql'
DB_HOST='127.0.0.1'
DB_PORT=54322
DB_USERNAME='postgres'
DB_PASSWORD='root'
DB_DATABASE='cradle-fastapi'
DB_ECHO=true
DB_MAX_OVERFLOW=10
DB_POOL_SIZE=50
DB_POOL_RECYCLE=3600
DB_POOL_TIMEOUT=30

REDIS_HOST='127.0.0.1'
REDIS_PORT=26379
REDIS_USERNAME=''
REDIS_PASSWORD=''
REDIS_DATABASE=12

RAG_LLM_API_BASE='https://api.siliconflow.cn/v1'
RAG_LLM_API_KEY=''
RAG_LLM_MODEL='Qwen/Qwen3-32B'
RAG_LLM_TEMPERATURE=0.7
RAG_LLM_MAX_TOKENS=2000

RAG_EMBEDDING_API_BASE='https://api.siliconflow.cn/v1'
RAG_EMBEDDING_API_KEY=''
RAG_EMBEDDING_MODEL='BAAI/bge-m3'
RAG_EMBEDDING_BATCH_SIZE=50
RAG_EMBEDDING_DIMENSION=1024
RAG_UPLOAD_SUBMIT_CONCURRENCY=2
RAG_UPLOAD_QUEUE_SIZE=0
RAG_UPLOAD_MAX_TOTAL_SIZE_MB=0
RAG_UPLOAD_MAX_SINGLE_FILE_SIZE_MB=200
RAG_PARSE_WORKER_COUNT=2
RAG_PARSE_QUEUE_MAX_SIZE=0
# RAG 文档存储类型，可选：local（本地磁盘）、minio（对象存储）
RAG_DOCUMENT_STORAGE='minio'
# MinIO 端点支持两种模式：
# 1. 外部共享 MinIO：<内网域名或IP>:9000
# 2. compose 内置 MinIO：cradle-minio:9000
RAG_MINIO_ENDPOINT='http://127.0.0.1:19000'
RAG_MINIO_ACCESS_KEY='replace-with-minio-access-key'
RAG_MINIO_SECRET_KEY='replace-with-minio-secret-key'
RAG_MINIO_BUCKET='cradle-rag'
RAG_MINIO_SECURE=false
RAG_MINIO_REGION=''

RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.7
RAG_SECURITY_BRIEF_ENABLED=false
RAG_SECURITY_BRIEF_SCENARIO_MARKERS='national-security,intel,intelligence'
RAG_SECURITY_BRIEF_QUERY_MARKERS='national-security,intel,intelligence'
RAG_ERA_MISMATCH_GUARD_ENABLED=false
RAG_ERA_MISMATCH_LEFT_MARKERS='kgb'
RAG_ERA_MISMATCH_RIGHT_MARKERS='qing-dynasty'
